+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+vi.mock("next/link", () => ({ default: ({children, ...props}: Record<string, unknown>) => createElement("a", props, children as string) }));
+import { CommissionPublicPage } from "./commission-public-page";
+import { CIRCLE_COMMISSION_TERMS } from "@/lib/circle-card/commission-member-controls";
+
+describe("public commissions explanation", () => {
+  it("leads to setup and shows current terms without accepting them for the visitor", () => {
+    const html = renderToStaticMarkup(createElement(CommissionPublicPage));
+    expect(html).toContain('href="/app/share/commissions"');
+    expect(html).toContain("/login?from=%2Fapp%2Fshare%2Fcommissions");
+    expect(html).toContain("30-day clearing"); expect(html).toContain("£20 normal payout minimum");
+    for (const term of CIRCLE_COMMISSION_TERMS) expect(html).toContain(term.replaceAll("'", "&#x27;"));
+    expect(html).not.toContain("<form");
+  });
+  it("explains promotions, prospective earnings and illustrative calculations", () => {
+    const html = renderToStaticMarkup(createElement(CommissionPublicPage));
+    expect(html).toContain("Discounted promotional payments are not automatically eligible");
+    expect(html).toContain("These are calculations, not forecasts");
+    expect(html).toContain("no backdating");
+    expect(html).toContain("£50");
+  });
+});
