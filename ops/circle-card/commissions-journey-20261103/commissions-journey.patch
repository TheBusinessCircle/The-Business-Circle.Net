+import { describe, expect, it } from "vitest";
+import { commissionSetupProgress, COMMISSIONS_LOGIN_PATH, COMMISSIONS_SETUP_PATH } from "./commission-journey";
+import { CIRCLE_COMMISSION_TERMS_VERSION, type CommissionMemberControls } from "./commission-member-controls";
+import { evaluateCustomerRuntimeRoute } from "./runtime-route-policy";
+import { resolveCircleCardAuthReturnPath } from "./routes";
+import { circlePrimaryDestination, resolveCircleExperienceHref } from "./experience";
+
+const ready: CommissionMemberControls = { enabled: false, revision: 9, termsVersion: CIRCLE_COMMISSION_TERMS_VERSION, onboardingStatus: "VERIFIED", payoutEligibility: true };
+describe("commissions setup journey", () => {
+  it("starts new members at Pro without pretending setup is complete", () => {
+    const progress = commissionSetupProgress(false, null, true);
+    expect(progress.nextStep).toBe(0); expect(progress.canEnable).toBe(false); expect(progress.earning).toBe(false);
+  });
+  it("remembers saved terms and directs the member to payouts", () => {
+    const progress = commissionSetupProgress(true, { ...ready, onboardingStatus: "INCOMPLETE", payoutEligibility: false }, true);
+    expect(progress.nextStep).toBe(2); expect(progress.termsAccepted).toBe(true); expect(progress.canEnable).toBe(false);
+  });
+  it("verified Stripe setup never enables earnings by itself", () => {
+    const progress = commissionSetupProgress(true, ready, true);
+    expect(progress.nextStep).toBe(3); expect(progress.canEnable).toBe(true); expect(progress.earning).toBe(false);
+  });
+  it("requires all earning gates even when the stored switch is ON", () => {
+    expect(commissionSetupProgress(true, { ...ready, enabled: true }, true).earning).toBe(true);
+    for (const change of [{ termsVersion: "old" }, { onboardingStatus: "RESTRICTED" as const }, { payoutEligibility: false }]) {
+      expect(commissionSetupProgress(true, { ...ready, enabled: true, ...change }, true).earning).toBe(false);
+    }
+    expect(commissionSetupProgress(true, { ...ready, enabled: true }, false).earning).toBe(false);
+    expect(commissionSetupProgress(false, { ...ready, enabled: true }, true).earning).toBe(false);
+  });
+  it("allows the public page and retains the setup destination across sign-in", () => {
+    expect(evaluateCustomerRuntimeRoute("circle-card", "/commissions")).toEqual({ action: "allow" });
+    expect(resolveCircleCardAuthReturnPath("/commissions", "circle-card")).toBe("/commissions");
+    expect(resolveCircleCardAuthReturnPath(new URL(COMMISSIONS_LOGIN_PATH, "https://circlecard.co.uk").searchParams.get("from"), "circle-card")).toBe(COMMISSIONS_SETUP_PATH);
+  });
+  it("gives commissions its own navigation selection and migrates old anchors", () => {
+    expect(circlePrimaryDestination(COMMISSIONS_SETUP_PATH)).toBe("commissions");
+    expect(circlePrimaryDestination("/app/share/referrals")).toBe("share");
+    expect(resolveCircleExperienceHref("/dashboard/circle-card#circle-commissions")).toBe(COMMISSIONS_SETUP_PATH);
+  });
+});
