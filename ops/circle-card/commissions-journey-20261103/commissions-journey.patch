+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({ user: vi.fn(), access: vi.fn(), controls: vi.fn(), legacy: vi.fn() }));
+vi.mock("next/link", () => ({ default: ({ children, ...props }: Record<string, unknown>) => createElement("a", props, children as string) }));
+vi.mock("next/navigation", () => ({ redirect: vi.fn(() => { throw new Error("redirect"); }) }));
+vi.mock("@/config/runtime-brand", () => ({ getRuntimeBrand: () => ({ key: "circle-card", canonicalOrigin: "https://circlecard.co.uk" }) }));
+vi.mock("@/lib/session", () => ({ requireCircleCardUser: mocks.user }));
+vi.mock("@/server/circle-card/billing.service", () => ({ loadCircleCardAccessForUser: mocks.access }));
+vi.mock("@/server/circle-card/commission-programme.service", () => ({ getCircleCommissionMemberControls: mocks.controls }));
+vi.mock("@/server/circle-card/commission.service", () => ({ getCircleCardCommissionEarningsForUser: mocks.legacy }));
+vi.mock("@/components/circle-card/circle-card-commission-member-area", () => ({ CircleCardCommissionMemberArea: () => createElement("div", null, "Owned commission controls") }));
+vi.mock("@/components/circle-card/circle-card-copy-link-button", () => ({ CircleCardCopyLinkButton: ({ publicUrl, label }: {publicUrl:string;label:string}) => createElement("button", {"data-link":publicUrl}, label) }));
+import CommissionsPage from "./page";
+
+describe("commission hub data failures and attribution", () => {
+  beforeEach(() => {
+    mocks.user.mockResolvedValue({ user: { id: "signed-in-owner" } });
+    mocks.access.mockResolvedValue({ hasProAccess: true });
+    mocks.controls.mockResolvedValue({ enabled: false });
+    mocks.legacy.mockResolvedValue({ referralCode: "OWNER123", pendingPence: 0, paidPence: 0 });
+  });
+  const render = async () => renderToStaticMarkup(await CommissionsPage({searchParams: Promise.resolve({})}));
+  it("loads only the signed-in member and puts their referral copy control in the hub", async () => {
+    const html = await render();
+    expect(mocks.controls).toHaveBeenCalledWith("signed-in-owner");
+    expect(mocks.legacy).toHaveBeenCalledWith("signed-in-owner");
+    expect(html).toContain("Copy referral link"); expect(html).toContain('data-link="https://circlecard.co.uk/r/owner123"');
+  });
+  it("hides mutation controls when setup status cannot be read", async () => {
+    mocks.controls.mockRejectedValue(new Error("database unavailable"));
+    const html = await render();
+    expect(html).toContain("We could not check your setup status");
+    expect(html).not.toContain("Owned commission controls");
+    expect(html).not.toContain("database unavailable");
+  });
+  it("keeps setup usable if old programme history cannot be checked", async () => {
+    mocks.legacy.mockRejectedValue(new Error("history unavailable"));
+    const html = await render();
+    expect(html).toContain("Owned commission controls");
+    expect(html).toContain("Previous programme history could not be checked");
+    expect(html).not.toContain("Copy referral link");
+  });
+});
