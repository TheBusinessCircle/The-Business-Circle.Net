+"use client";
+
+import { useFormStatus } from "react-dom";
+import type { ComponentProps } from "react";
+
+export function CommissionSubmitButton({ children, disabled, ...props }: ComponentProps<"button">) {
+  const { pending, data } = useFormStatus();
+  const isSubmitting = pending && (!props.value || data?.get("intent") === props.value);
+  return <button {...props} type="submit" disabled={disabled || pending} aria-busy={isSubmitting || undefined}>{isSubmitting ? "Please wait…" : children}</button>;
+}
