+import Link from "next/link";
+import { ArrowRight, BadgeCheck, Coins, Link2, ShieldCheck } from "lucide-react";
+import { CIRCLE_COMMISSION_PROGRAMME_OPEN, CIRCLE_COMMISSION_TERMS, CIRCLE_COMMISSION_TERMS_VERSION } from "@/lib/circle-card/commission-member-controls";
+import { COMMISSIONS_LOGIN_PATH, COMMISSIONS_SETUP_PATH } from "@/lib/circle-card/commission-journey";
+import styles from "./commission-public.module.css";
+
+const faqs = [
+  ["Do I need Pro?", "Yes. You need active Circle Card Pro access to earn. Pro normally costs £9.99 a month. Eligible included or complimentary Pro members can also enrol, but referred free or complimentary upgrades do not earn commission."],
+  ["What counts as an eligible referral?", "A person directly attributed to your personal referral link who makes a qualifying £9.99 monthly Pro payment while your commissions and eligibility are active. Self-referrals, unpaid invoices and free or complimentary access do not qualify. Discounted promotional payments are not automatically eligible."],
+  ["When can I receive a payout?", "Earnings stay pending for 30 days and provider checks. Cleared balances of £20 or more are reviewed monthly by the owner. Smaller balances carry forward while active. Payouts are not automatic or guaranteed on a particular date; Stripe confirms bank payouts separately."],
+  ["What happens if I switch OFF?", "New earnings stop. Your referral attribution stays linked to you. Switching back ON resumes future qualifying payments only, with no backdating. Below-£20 balances are subject to the six-month inactivity rules in the terms below."],
+  ["Does Stripe verification switch commissions ON?", "No. Return to your commissions hub after verification, check the setup status and switch commissions ON yourself. If Stripe still needs information, resume the existing payout setup rather than creating another account."],
+  ["What about refunds or losing Pro?", "Refunds, disputes or substantiated abuse can hold or reverse earnings. Losing Pro stops new earnings. Your existing records are retained, and reactivating Pro does not backdate missed earnings."],
+  ["Where should I share my link?", "Copy your personal referral link from the hub and share it with people who may find Circle Card useful: your bio, website, content or relevant conversations. Make it clear that you may earn commission. A generic homepage link or a connection alone does not establish referral credit."],
+  ["My setup is stuck. What should I do?", "Check the next incomplete step in your hub. If terms are already saved, you do not need to accept them again. Resume Stripe for verification issues. For saving or activation errors, contact support@circlecard.co.uk with the message shown; do not send bank details or identity documents."],
+] as const;
+
+export function CommissionPublicPage() {
+  return <div className={styles.page}>
+    <section className={styles.hero} aria-labelledby="commissions-title">
+      <div><p className={styles.kicker}>YOUR CIRCLE. MORE POSSIBILITIES.</p><h1 id="commissions-title">Share something useful.<br /><span>Get rewarded.</span></h1><p className={styles.intro}>Introduce people to Circle Card Pro and earn £2 for each eligible paid referral month. One personal link. Recurring rewards. Always your choice.</p><div className={styles.actions}><Link className={styles.primary} href={COMMISSIONS_SETUP_PATH}>Set up commissions <ArrowRight size={18} /></Link><a className={styles.secondary} href="#how-it-works">Show me how</a></div><p className={styles.small}>{CIRCLE_COMMISSION_PROGRAMME_OPEN ? "Optional with active Pro. OFF until you choose to switch ON." : "The programme is preparing to open. No new earnings accrue yet."} Earnings are not guaranteed.</p><Link href={COMMISSIONS_LOGIN_PATH} className={styles.textLink}>Already have an account? Log in to your hub</Link></div>
+      <div className={styles.reward} aria-label="Commission reward"><div className={styles.orbit} aria-hidden="true"><Coins size={36} /></div><p className={styles.kicker}>CIRCLE COMMISSIONS</p><p className={styles.amount}>£2<span>/ eligible month</span></p><p>For each direct referral’s qualifying<br />£9.99 monthly Pro payment.</p><div className={styles.pills}><span><BadgeCheck size={15} /> Recurring rewards</span><span><ShieldCheck size={15} /> You control ON / OFF</span></div><p className={styles.small}>30-day clearing · £20 normal payout minimum<br />Monthly owner review · No Circle Card earnings cap</p></div>
+    </section>
+    <section id="how-it-works" className={styles.section} aria-labelledby="setup-heading"><p className={styles.kicker}>FROM FIRST CLICK TO SWITCHED ON</p><h2 id="setup-heading">Four clear steps. One place to manage it.</h2><div className={styles.steps}>{[
+      ["01", "Activate Pro", "Sign in or create your Circle Card, then activate Pro if you need it. Already have eligible Pro access? Keep going."],
+      ["02", "Accept the terms", "Open your commissions hub, read the terms and save your acceptance. The hub remembers this step."],
+      ["03", "Connect Stripe", "Use Set up Stripe payouts to complete identity and payout verification securely with Stripe. Return to your hub afterwards."],
+      ["04", "Switch ON & share", "When setup is verified, turn commissions ON. Copy your personal referral link and share it. Track qualifying earnings in the same hub."],
+    ].map(([number, title, text]) => <article key={number}><span className={styles.number}>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div><Link href={COMMISSIONS_SETUP_PATH} className={styles.textLink}>Take me to my setup <ArrowRight size={17} /></Link></section>
+    <section className={styles.example} aria-labelledby="example-heading"><div><p className={styles.kicker}>SEE HOW IT ADDS UP</p><h2 id="example-heading">A little introduction.<br />A lasting connection.</h2><p>Rewards can repeat when your direct referrals renew, as long as each payment qualifies and your eligibility stays active.</p></div><div><table><caption>Illustrative monthly commission, before any reversals or tax</caption><thead><tr><th scope="col">Qualifying paid referrals</th><th scope="col">Commission that month</th></tr></thead><tbody>{[[5, "£10"], [10, "£20"], [25, "£50"]].map(([count, amount]) => <tr key={count}><th scope="row">{count}</th><td>{amount}</td></tr>)}</tbody></table><p className={styles.small}>Examples assume one qualifying £9.99 monthly payment per referral. These are calculations, not forecasts or payout promises. £10 stays below the normal payout minimum.</p></div></section>
+    <section className={styles.section} aria-labelledby="clear-heading"><p className={styles.kicker}>CLEAR FROM THE START</p><h2 id="clear-heading">You share. We keep the rules clear.</h2><div className={styles.rules}><article><Link2 /><h3>Your own referral link</h3><p>Use the link from your account so introductions can be attributed to you. Connection activity alone does not earn commission.</p></article><article><Coins /><h3>Pending is a real stage</h3><p>Allow 30 days and provider checks. Your hub separates pending, available, reviewed and Stripe-transferred earnings.</p></article><article><ShieldCheck /><h3>Your switch, your choice</h3><p>Nothing accrues while OFF. Turning ON never backdates earnings. Payouts always need owner review.</p></article></div></section>
+    <section className={styles.section} aria-labelledby="faq-heading"><p className={styles.kicker}>THE DETAILS THAT MATTER</p><h2 id="faq-heading">Your questions, answered.</h2><div className={styles.faq}>{faqs.map(([question, answer]) => <details key={question}><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
+    <section className={styles.terms} id="commission-terms"><details><summary>Read the current Commission Terms</summary><p className={styles.small}>Version {CIRCLE_COMMISSION_TERMS_VERSION}. Acceptance happens in your signed-in hub.</p><ol>{CIRCLE_COMMISSION_TERMS.map(term => <li key={term}>{term}</li>)}</ol></details></section>
+    <section className={styles.finish}><p className={styles.kicker}>READY WHEN YOU ARE</p><h2>Your next introduction<br />could go further.</h2><p>Set up once. Choose when to earn. Keep everything in your commissions hub.</p><div className={styles.actions}><Link className={styles.primary} href={COMMISSIONS_SETUP_PATH}>Open my commissions hub <ArrowRight size={18} /></Link><Link className={styles.secondary} href="/pro">Explore Pro · £9.99/month</Link></div></section>
+  </div>;
+}
