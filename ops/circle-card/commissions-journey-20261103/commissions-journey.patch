+import { CIRCLE_COMMISSION_TERMS_VERSION, type CommissionMemberControls } from "./commission-member-controls";
+
+export const COMMISSIONS_PUBLIC_PATH = "/commissions";
+export const COMMISSIONS_SETUP_PATH = "/app/share/commissions";
+export const COMMISSIONS_LOGIN_PATH = `/login?from=${encodeURIComponent(COMMISSIONS_SETUP_PATH)}`;
+
+export function commissionSetupProgress(hasProAccess: boolean, controls: CommissionMemberControls | null, programmeOpen: boolean) {
+  const termsAccepted = controls?.termsVersion === CIRCLE_COMMISSION_TERMS_VERSION;
+  const payoutsReady = controls?.onboardingStatus === "VERIFIED" && controls.payoutEligibility;
+  const ready = hasProAccess && termsAccepted && payoutsReady && programmeOpen;
+  const earning = Boolean(ready && controls?.enabled);
+  const steps = [
+    { title: "Activate Pro", complete: hasProAccess, detail: "Active Pro access unlocks the optional programme." },
+    { title: "Accept the terms", complete: termsAccepted, detail: "Read the commission terms and save your acceptance." },
+    { title: "Set up Stripe payouts", complete: Boolean(payoutsReady), detail: "Complete verification with Stripe, then return here." },
+    { title: "Turn commissions on", complete: earning, detail: "Switch ON before sharing your personal referral link." },
+  ];
+  return { termsAccepted, payoutsReady, canEnable: ready, earning, steps, nextStep: steps.findIndex(step => !step.complete) };
+}
